# syntax=docker/dockerfile:1
# Builds gomuks web with the embedded wasm backend and packages it as a
# single static Go binary (cmd/wasmukserve) that serves it. See docs/wasmuks.md.
#
# The build needs a few GB of RAM (Go links a 30 MB wasm binary and vite
# bundles the frontend). Build it on a PC or in CI, not on a Raspberry Pi;
# the resulting image is tiny and runs anywhere.
ARG GO_VERSION=1.27
ARG NODE_VERSION=24

# --platform=$BUILDPLATFORM: the wasm binary and the JS bundle are the same
# for every target architecture, so build them natively instead of under
# QEMU emulation when producing arm64 images.
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS wasm
RUN apk add --no-cache git
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN cd web \
	&& go run ../pkg/hicli/cmdspec/print src/api/types/stdcommands.json src/api/types/stdcommands.d.ts \
	&& ./build-wasm.sh
# Code block themes. The server build generates this CSS on request; a static
# deployment has to ship it, or code blocks in messages come out unstyled.
RUN mkdir -p /codeblock && go run ./cmd/chromagen /codeblock/

FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --include=dev
COPY web/ ./
COPY --from=wasm /src/web/src/api/wasm/_gomuks.wasm src/api/wasm/_gomuks.wasm
COPY --from=wasm /src/web/src/api/types/stdcommands.json /src/web/src/api/types/stdcommands.d.ts src/api/types/
COPY --from=wasm /codeblock public/_gomuks/codeblock
# Pre-compressed sidecars, so wasmukserve never compresses 30 MB of wasm per
# request. Brotli is about 30% smaller than gzip on the wasm binary (4.9 MB
# against 7.1 MB), which is the download that decides how long a cold start
# takes; gzip stays for the rare client that doesn't take brotli. Compressing
# the wasm at quality 11 takes about a minute of build time.
RUN apk add --no-cache brotli
RUN npm run build \
	&& find dist -type f \( -name '*.wasm' -o -name '*.js' -o -name '*.css' -o -name '*.html' -o -name '*.json' -o -name '*.svg' \) \
		-exec gzip -9 -k {} + \
	&& find dist -type f \( -name '*.wasm' -o -name '*.js' -o -name '*.css' -o -name '*.html' -o -name '*.json' -o -name '*.svg' \) \
		-exec brotli -q 11 -k {} +

# The server binary embeds web/dist (like the native gomuks server does), so
# the final image is just that one static binary.
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS server
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/web/dist web/dist
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -ldflags="-s -w" -o /wasmukserve ./cmd/wasmukserve

FROM scratch
COPY --from=server /wasmukserve /wasmukserve
USER 65534:65534
ENV WASMUKS_LISTEN=0.0.0.0:8181
EXPOSE 8181
ENTRYPOINT ["/wasmukserve"]
